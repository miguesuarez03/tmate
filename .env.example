# Google Analytics 4 — Measurement ID de tu propiedad GA4 (analytics.google.com).
# Sin esta variable, el sitio funciona igual pero no se carga gtag.js ni se
# envían eventos. Copia este fichero a .env.local y rellena el valor real.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Web3Forms — access key del formulario de feedback «¿Qué te falta?»
# (web3forms.com, gratis). Sin esta variable, el botón de feedback hace
# fallback a un mailto: con el mensaje ya rellenado.
VITE_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
